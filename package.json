{
  "name": "netos-knowledge-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate": "node --import tsx scripts/validate-content.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run validate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "qa": "npm run check && npm test && npm run build && npm run verify:dist && npm run test:e2e",
    "verify:dist": "node --import tsx scripts/verify-dist.ts",
    "format": "prettier --write src scripts tests astro.config.mjs playwright.config.ts",
    "test:discovery": "node --import tsx tests/integration/discovery.ts",
    "test:templates": "node --import tsx tests/integration/templates.ts",
    "capture:preview": "node tests/visual/capture-preview.mjs",
    "capture:reader": "node tests/visual/capture-reader.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.4.2",
    "gray-matter": "^4.0.3",
    "mermaid": "^12.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
