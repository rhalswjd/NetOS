---
import Icon from './Icon.astro';
import { url } from '../lib/routes';
---

<button
  class="search-trigger"
  type="button"
  aria-label="Search knowledge archive"
  aria-haspopup="dialog"
>
  <Icon name="search" size={17} />
  <span>Search</span>
  <kbd>⌘ K</kbd>
</button>
<dialog
  class="search-dialog"
  aria-labelledby="search-title"
  data-search-base={url('/pagefind/pagefind.js')}
>
  <div class="search-heading">
    <h2 id="search-title">Search the archive</h2>
    <button class="icon-button" data-close-search aria-label="Close search">
      <Icon name="close" size={19} />
    </button>
  </div>
  <label for="global-search" class="sr-only">
    Search all documents
  </label>
  <div class="search-field">
    <Icon name="search" size={20} />
    <input
      id="global-search"
      type="search"
      placeholder="An idea, protocol, or question…"
      autocomplete="off"
    />
  </div>
  <p class="search-status" role="status">
    Search concepts, experiments, research, and problems.
  </p>
  <div class="search-results"></div>
  <p class="search-hint">
    ↑ Explore results with Tab <span>Esc to close</span>
  </p>
</dialog>
<script>
  type SearchData = { url: string; meta: { title?: string }; excerpt: string };
  type SearchModule = {
    search: (
      query: string,
    ) => Promise<{ results: { data: () => Promise<SearchData> }[] }>;
  };
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = dialog.querySelector<HTMLInputElement>('input')!;
  const status = dialog.querySelector<HTMLElement>('.search-status')!;
  const output = dialog.querySelector<HTMLElement>('.search-results')!;
  let engine: Promise<SearchModule> | undefined;
  let request = 0;
  function openSearch() {
    dialog.showModal();
    input.focus();
  }
  document
    .querySelector('.search-trigger')
    ?.addEventListener('click', openSearch);
  dialog
    .querySelector('[data-close-search]')
    ?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) {
      const r = dialog.getBoundingClientRect();
      if (
        e.clientX < r.left ||
        e.clientX > r.right ||
        e.clientY < r.top ||
        e.clientY > r.bottom
      )
        dialog.close();
    }
  });
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : openSearch();
    }
  });
  input.addEventListener('input', async () => {
    const version = ++request;
    const query = input.value.trim();
    if (!query) {
      output.replaceChildren();
      status.textContent =
        'Search concepts, experiments, research, and problems.';
      return;
    }
    status.textContent = 'Searching…';
    try {
      engine ??= import(/* @vite-ignore */ dialog.dataset.searchBase!);
      const index = await engine!;
      const found = await index.search(query);
      const results = await Promise.all(
        found.results.slice(0, 15).map((r) => r.data()),
      );
      if (version !== request) return;
      output.replaceChildren();
      status.textContent = `${found.results.length} ${found.results.length === 1 ? 'result' : 'results'} for “${query}”`;
      for (const result of results) {
        const a = document.createElement('a');
        a.className = 'search-result';
        a.href = result.url;
        const title = document.createElement('strong');
        title.textContent = result.meta.title ?? 'Untitled document';
        const excerpt = document.createElement('p');
        // Pagefind supplies highlighted markup; parse only its text to avoid HTML injection.
        const parsed = new DOMParser().parseFromString(
          result.excerpt,
          'text/html',
        );
        excerpt.textContent = parsed.body.textContent;
        a.append(title, excerpt);
        output.append(a);
      }
    } catch {
      if (version !== request) return;
      engine = undefined;
      status.textContent =
        'The full-text index is generated by the production build. Use a production preview to search, or browse the archives.';
    }
  });
</script>
