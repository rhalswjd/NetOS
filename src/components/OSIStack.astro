---
import { networkLayers } from '../lib/taxonomy';
import { url } from '../lib/routes';
---

<div class="osi-stack" aria-label="OSI seven-layer model">
  {networkLayers.map((layer, i) => (
    <a
      class="osi-layer"
      href={url(`/network/layers/${layer.id}/`)}
      aria-label={`L${layer.number} — ${layer.name}`}
      style={`--layer-index: ${i}; --layer-blue: ${92 - i * 4}%; z-index: ${8 - i}`}
    >
      <svg class="cylinder" viewBox="0 0 300 98" aria-hidden="true">
        <defs>
          <linearGradient id={`body-${layer.id}`} x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color={`hsl(210 25% ${79 - i * 3}%)`} />
            <stop offset="48%" stop-color={`hsl(210 30% ${88 - i * 3}%)`} />
            <stop offset="100%" stop-color={`hsl(210 25% ${72 - i * 3}%)`} />
          </linearGradient>
          <linearGradient id={`top-${layer.id}`} x2="0" y2="1">
            <stop stop-color={`hsl(210 31% ${95 - i * 3}%)`} />
            <stop offset="1" stop-color={`hsl(210 28% ${85 - i * 3}%)`} />
          </linearGradient>
        </defs>
        <path
          d="M15 26 C15 0 285 0 285 26 V66 C285 99 15 99 15 66Z"
          fill={`url(#body-${layer.id})`}
          stroke="#6b89a3"
          stroke-opacity=".5"
        />
        <ellipse
          cx="150"
          cy="26"
          rx="135"
          ry="23"
          fill={`url(#top-${layer.id})`}
          stroke="#9fb4c7"
          stroke-width="1"
        />
        <path
          d="M24 31c30 24 222 24 252 0"
          fill="none"
          stroke="white"
          stroke-opacity=".35"
        />
        <text
          x="150"
          y="72"
          text-anchor="middle"
          fill="#304e69"
          font-size="15"
          font-weight="550"
          font-family="system-ui"
        >
          L{layer.number} <tspan dx="6">{layer.name}</tspan>
        </text>
      </svg>
      <span class="layer-connector"></span>
      <span class="layer-annotation">
        <span class="layer-number">LAYER {layer.number}</span>
        <strong>{layer.name}</strong>
        <span>{layer.keywords.join(' · ')}</span>
      </span>
    </a>
  ))}
</div>
