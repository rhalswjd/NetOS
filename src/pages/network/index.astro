---
import Layout from '../../layouts/Layout.astro';
import OSIStack from '../../components/OSIStack.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/routes';
import { networkLayers } from '../../lib/taxonomy';
import { getContentIndex } from '../../lib/content-index';
const { documents } = await getContentIndex();
---

<Layout
  title="Network"
  description="Explore the seven layers of computer networking through an interactive cylindrical OSI model."
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={url('/')}>Overview</a>
    <Icon name="chevron" size={12} />
    <span>Network</span>
  </nav>
  <div class="explorer-heading">
    <div>
      <p class="eyebrow">THE ART OF CONNECTION</p>
      <h1>Network</h1>
      <p>One message. Seven perspectives.</p>
    </div>
    <span class="explorer-badge">
      <Icon name="layers" size={17} /> OSI reference model
    </span>
  </div>
  <section class="network-explorer">
    <div class="explorer-context">
      <span class="diagram-index">01 / EXPLORER</span>
      <h2>
        A stack of
        <br /> possibilities.
      </h2>
      <p>
        Every connection has a story. Follow it from the applications we use
        down to the signals that carry it.
      </p>
      <div class="explorer-instruction">
        <span class="instruction-line"></span>
        <p>Select a layer to explore its concepts and connected notes.</p>
      </div>
      <div class="model-note">
        <Icon name="book" size={18} />
        <p>
          A model, not a rigid rulebook. Real protocols can span layers; the OSI
          model is a guide to reasoning about responsibilities.
        </p>
      </div>
    </div>
    <div class="stack-stage">
      <div class="stack-axis">
        <span>Closer to the application</span>
        <span>Closer to the medium</span>
      </div>
      <OSIStack />
    </div>
  </section>
  <div class="explorer-bottom">
    <span>
      <span class="status-dot"></span>
      {networkLayers.length} layers ·{' '}
      {documents.filter((d) => d.data.domain === 'network').length} connected
      documents
    </span>
    <a class="text-link" href={url('/archive/concepts/?domain=network')}>
      Browse Network concepts <Icon name="arrow" size={16} />
    </a>
  </div>
</Layout>
