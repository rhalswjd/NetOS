---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HomeMotif from '../components/HomeMotif.astro';
import DocumentCard from '../components/DocumentCard.astro';
import { getContentIndex } from '../lib/content-index';
import { url } from '../lib/routes';
import { documentTypes, networkLayers } from '../lib/taxonomy';
const { documents } = await getContentIndex();
const recent = [...documents]
  .sort(
    (a, b) =>
      (b.data.updatedAt ?? b.data.createdAt).getTime() -
      (a.data.updatedAt ?? a.data.createdAt).getTime(),
  )
  .slice(0, 3);
---

<Layout>
  <section class="home-intro">
    <p class="eyebrow">
      <span class="status-dot"></span>A PERSONAL KNOWLEDGE SPACE
    </p>
    <h1>Small discoveries. Deeper understanding.</h1>
    <p>Exploring the systems behind the everyday.</p>
  </section>
  <section class="subject-cards" aria-label="Explore subjects">
    <div class="float-wrap">
      <a class="subject-card network-card" href={url('/network/')}>
        <div class="subject-card-top">
          <span class="subject-overline">CONNECTIONS, EXPLAINED</span>
          <span class="small-tag">01</span>
        </div>
        <HomeMotif kind="network" />
        <div class="subject-card-label">
          <div>
            <h2>Network</h2>
            <p>From a single bit to a connected world.</p>
          </div>
          <span class="round-arrow">
            <Icon name="arrow" size={21} />
          </span>
        </div>
        <div class="subject-card-foot">
          <span>OSI model</span>
          <span class="meta-dot">·</span>
          <span>{networkLayers.length} layers to explore</span>
        </div>
      </a>
    </div>
    <div class="float-wrap">
      <a class="subject-card os-card" href={url('/os/')}>
        <div class="subject-card-top">
          <span class="subject-overline">COMPLEXITY, UNDERSTOOD</span>
          <span class="small-tag">02</span>
        </div>
        <HomeMotif kind="os" />
        <div class="subject-card-label">
          <div>
            <h2>Operating System</h2>
            <p>The quiet architecture of a running machine.</p>
          </div>
          <span class="round-arrow">
            <Icon name="arrow" size={21} />
          </span>
        </div>
        <div class="subject-card-foot">
          <span>Kernel architecture</span>
          <span class="meta-dot">·</span>
          <span>Explore from the inside</span>
        </div>
      </a>
    </div>
  </section>
  <p class="home-caption">
    <span></span>Two perspectives. One connected understanding.<span></span>
  </p>
  <section class="archive-panel" aria-labelledby="archive-heading">
    <div class="archive-panel-heading">
      <h2 id="archive-heading">Knowledge Archive</h2>
      <span>Collected along the way</span>
    </div>
    <div class="archive-entries">
      {documentTypes.map((type) => (
        <a href={url(`/archive/${type.slug}/`)}>
          <Icon name={type.icon} size={27} />
          <strong>{type.label}</strong>
          <span lang="ko">{type.korean}</span>
        </a>
      ))}
    </div>
  </section>
  <section class="recent-section">
    <div class="section-heading">
      <h2>Recently added</h2>
      <a class="text-link" href={url('/archive/concepts/')}>
        Browse the archive <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="document-grid recent-grid">
      {recent.map((document) => (
        <DocumentCard document={document} />
      ))}
    </div>
    <p class="collection-note">
      <span class="status-dot"></span>
      {documents.length} connected documents. Always a work in progress.
    </p>
  </section>
</Layout>
